  "cards": [
    {
      "dot": "cyan",
      "title": "Sources",
      "items": [
        "Paid calls go through Apify and treg.to, the runner enforces the budget",
        "LinkedIn through Apify and treg.to, the extension reads 3 fields",
        "Steps pass only sourceId and excerpt, the payload stays in R2"
      ]
    },
    {
      "dot": "emerald",
      "title": "Processing",
      "items": [
        "LLM only in fixed seams: seed, role, resolve, extract, verify, synthesize",
        "FACT only with a quote inside the source excerpt",
        "Without AI the brief is built from evidence only, marked NO AI"
      ]
    },
    {
      "dot": "rose",
      "title": "Data protection",
      "items": [
        "No Art. 9 data, filtered in synthesis, state view and call",
        "The ledger is append-only, every step with its cost",
        "Cron or rejection deletes D1 and R2 data after 7 days"
      ]
    }
