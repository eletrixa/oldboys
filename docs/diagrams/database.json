  "cards": [
    {
      "dot": "cyan",
      "title": "How to read",
      "items": [
        "Arrow = foreign key, from child to parent",
        "Arrow into investigations = run_id",
        "Dashed = link without REFERENCES",
        "investigations.organization_id has no arrow"
      ]
    },
    {
      "dot": "violet",
      "title": "Outside D1",
      "items": [
        "R2: raw JSON, CV, transcript, Czech brief, call questions, positions",
        "Workflow state lives in Cloudflare, not in D1",
        "No KV and no Durable Objects"
      ]
    },
    {
      "dot": "rose",
      "title": "Deletion",
      "items": [
        "Cron at 03:00 deletes runs older than 7 days",
        "Delete on rejection runs the same function at once",
        "Positions go at their own expires_at"
      ]
    }
