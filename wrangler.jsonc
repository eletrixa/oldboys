{
  // Cloudflare Worker config: bindings, custom domain and non-secret vars for the oldboys worker.
  // Project: oldboys — goal-conditioned, sourced deep research on a person or company (Apify hackathon)
  // Module:  wrangler.jsonc
  // Deps:    wrangler, @opennextjs/cloudflare
  // Tested:  n/a (wrangler deploy --dry-run in CI)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oldboys",
  // Custom entry: wraps the OpenNext-generated fetch handler and exports the Workflow class.
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Custom domain on the asajj.cz zone; wrangler creates DNS + cert on deploy.
  "routes": [{ "pattern": "oldboys.asajj.cz", "custom_domain": true }],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "oldboys",
      "database_id": "5c16c2bf-ed76-41e6-8d82-fec68ec3f3c6",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "SOURCES",
      "bucket_name": "oldboys-sources"
    }
  ],
  "workflows": [
    {
      "binding": "RESEARCH_RUN",
      "name": "oldboys-research-run",
      "class_name": "ResearchRunWorkflow"
    },
    {
      "binding": "VERIFY_CALL",
      "name": "oldboys-verification-call",
      "class_name": "VerificationCallWorkflow"
    }
  ],
  // CALL_PROVIDER is "mock" or "elevenlabs". The two ElevenLabs ids are non-secret dashboard ids.
  // Intake (plans/008): INTAKE_PER_HOUR_CAP caps runs started from applications per hour; INTAKE_FORWARD_TO is the
  // verified Email Routing destination that gets a copy of every inbound mail (empty = no copy); INTAKE_FROM_ALLOW is a
  // comma list of sender domains or addresses allowed to start runs by email (empty = any sender).
  // Non-secret config only. Secrets: `wrangler secret put` / .dev.vars (see .dev.vars.example). Optional secrets: GITHUB_TOKEN, STACKEXCHANGE_KEY, OPENALEX_API_KEY, INTAKE_TOKEN, STARTUPJOBS_WEBHOOK_TOKEN, STARTUPJOBS_TOKEN.
  // Nightly purge of expired raw sources (src/workflow/purge.ts)
  "triggers": { "crons": ["0 3 * * *"] },
  "vars": {
    "LLM_MODEL_PRIMARY": "claude-opus-5-5",
    "LLM_MODEL_VERIFY": "claude-sonnet-5-5",
    "RUN_BUDGET_USD": "0.50",
    "RUN_BUDGET_CALLS": "16",
    "CALL_PROVIDER": "mock",
    "CALL_BUDGET_USD": "0.50",
    "RUN_CALL_MAX": "2",
    "ELEVENLABS_AGENT_ID": "",
    "ELEVENLABS_PHONE_NUMBER_ID": "",
    "INTAKE_PER_HOUR_CAP": "10",
    "INTAKE_FORWARD_TO": "",
    "INTAKE_FROM_ALLOW": ""
  }
}
