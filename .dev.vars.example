# Local secrets for `wrangler dev` / `next dev` via initOpenNextCloudflareForDev. Copy to .dev.vars (gitignored).
ANTHROPIC_API_KEY=
APIFY_TOKEN=
ELEVENLABS_API_KEY=
# Bearer token clients must send to POST /api/runs (openssl rand -hex 24)
RUN_TOKEN=
# HMAC secret shown when the post-call webhook is created in the ElevenLabs workspace settings
ELEVENLABS_WEBHOOK_SECRET=
# Optional: GitHub token (no scopes) lifts api.github.com from the shared anonymous limit to 5000 req/h
GITHUB_TOKEN=
# Optional: treg.to per-org token (treg login; https://treg.to); without it the treg/* steps record "not searched: TREG_TOKEN not set"
TREG_TOKEN=
# Optional: Stack Exchange app key (stackapps.com) lifts the 300 req/day per IP quota
STACKEXCHANGE_KEY=
# Optional: OpenAlex free API key (openalex.org/settings/api); anonymous budget is shared and answers 429 from the Worker IP
OPENALEX_API_KEY=
# Optional: Brave Search API key (api-dashboard.search.brave.com); without it the start form offers no profile suggestions (503)
BRAVE_SEARCH_KEY=
# Budget cap (USD) for the LLM call that extracts a position's must-haves
POSITION_INGEST_USD=0.05
# Intake: bearer token the Google Forms Apps Script sends to POST /api/intake/form (openssl rand -hex 24)
INTAKE_TOKEN=
# Intake: secret path segment of the StartupJobs webhook URL /api/intake/startupjobs/<token> (openssl rand -hex 24)
STARTUPJOBS_WEBHOOK_TOKEN=
# Optional: StartupJobs company API bearer, sent with CV file downloads from startupjobs.cz hosts (the API itself is never called)
STARTUPJOBS_TOKEN=
